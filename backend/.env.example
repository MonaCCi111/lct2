# Локальный запуск без Docker (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./app.db
# В Docker (см. docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/moscollector

CORS_ORIGINS=*
DATA_DIR=./data
# Пакет ML-интеграции (integration/backend_sanya из ветки feature/ml-research), опционально
ML_HANDOFF_DIR=./data/ml_handoff
# Для произвольного исторического таймлайна подключите полный архив ML и справочник каналов.
# Готовые сценарии работают и без этих переменных. Кэш остаётся локальным и не входит в Git.
# REPLAY_SOURCE_ROOT=G:/lct2/tmp/publish_ml/production_ml/data
# REPLAY_CATALOG=G:/lct2/dataset/справочник_каналов_датчиков.csv
# REPLAY_CACHE_DIR=./data/replay_cache
LOG_LEVEL=info
